:root{--r:#641522;--d:#390910;--g:#c79a49;--c:#f7eddc;--w:#fffaf1;--t:#44362f;--mut:#76645a}*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}/* =========================================================
   GANTI BACKGROUND UNDANGAN DI SINI:
   assets/background.jpg
   Foto ini dipakai dari cover pembuka sampai bagian akhir.
   ========================================================= */
body{font-family:Georgia,'Times New Roman',serif;background:var(--c) url
    ('assets/bakcground.png') center top/cover fixed no-repeat;color:var(--t);overflow-x:hidden;position:relative}body:before{content:'';position:fixed;inset:0;background:rgba(35,8,12,.30);z-index:-1;pointer-events:none}body.lock{overflow:hidden}#cover{position:fixed;inset:0;z-index:9;display:grid;place-items:center;padding:15px;background:linear-gradient(rgba(53,8,15,.58),rgba(53,8,15,.72)),
        url('assets/bakcground.png') center/cover no-repeat;color:#fff;transition:.7s}.frame{width:min(470px,100%);min-height:94svh;border:4px solid var(--g);outline:2px solid var(--r);outline-offset:-12px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.gorga{height:30px;background:repeating-linear-gradient(45deg,transparent 0 7px,var(--g) 7px 10px,transparent 10px 17px),repeating-linear-gradient(-45deg,transparent 0 7px,var(--r) 7px 10px,transparent 10px 17px);border-block:2px solid var(--g)}.cover-content{text-align:center;padding:25px;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1}.cover-content small,.hero small,section>small{letter-spacing:4px}.cover-photo{width:205px;height:265px;object-fit:cover;padding:5px;background:#fff;border:4px solid var(--g);margin:18px}.cover-content h1{font-size:clamp(40px,10vw,58px);line-height:.95}.cover-content h1 span,.hero h2 span{display:block;color:var(--g);font-size:.55em;margin:7px}.cover-content p{color:#ead7ad;margin:10px}.cover-content b{margin:6px 0 18px}.cover-content button,.hero a,form button{border:0;border-radius:50px;background:var(--g);color:#32140f;font-weight:700;padding:13px 25px;text-decoration:none;cursor:pointer}.hero{min-height:100svh;position:relative;display:grid;place-items:center;text-align:center;padding:80px 20px;color:#fff;background:linear-gradient(rgba(59,9,16,.62),rgba(59,9,16,.74)),
            url('assets/bakcground.png') center/cover fixed no-repeat}.hero>div:nth-child(2){max-width:700px}.hero h2{font-size:clamp(48px,11vw,88px);line-height:.95;margin:18px}.hero p,.lead{max-width:700px;margin:0 auto 28px;line-height:1.8;color:#f0e0c5}.hero .top{position:absolute;top:0;left:0;right:0}.hero .bottom{position:absolute;bottom:0;left:0;right:0}section{max-width:1050px;margin:auto;padding:75px 20px;text-align:center;background:rgba(255,250,241,.10);backdrop-filter:blur(1.5px)}section>small{color:var(--r)}section h2{color:var(--r);font-size:clamp(28px,5vw,38px);margin:9px 0 15px}.lead{color:var(--mut);margin-bottom:0}.cream{max-width:none;background:rgba(255,250,241,.14)}.couple{max-width:850px;margin:35px auto;display:grid;grid-template-columns:1fr 80px 1fr;align-items:center}.couple article{padding:15px}.couple article img{width:185px;height:225px;object-fit:cover;padding:5px;border:5px solid var(--g);background:#fff}.couple h3{color:var(--r);font-size:24px;margin:13px}.couple p{line-height:1.7;color:var(--mut);font-size:14px}.couple>strong{font-size:48px;color:var(--g)}.quote,.location,.events article,form{background:#fff;border:1px solid #ead6a9;border-radius:20px;box-shadow:0 12px 30px #4d1c1010}.quote{max-width:760px;margin:25px auto;padding:30px;font-style:italic;font-size:18px;line-height:1.8}.quote b{display:block;color:var(--r);font-style:normal;margin-top:12px}.count{max-width:650px;margin:30px auto;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.count div{background:var(--r);color:#fff;padding:15px 5px;border-radius:12px;font-size:10px}.count b{display:block;color:var(--g);font-size:28px}.events{max-width:800px;margin:30px auto;display:grid;grid-template-columns:1fr 1fr;gap:20px}.events article{padding:30px 20px}.events i{font-size:34px}.events h3{color:var(--r);font-size:23px;margin:10px}.events p,.location p{line-height:1.8;color:var(--mut)}.timeline{max-width:680px;margin:30px auto;text-align:left}.timeline p{border-left:3px solid var(--g);padding:0 0 22px 25px;color:var(--mut)}.timeline b{display:block;color:var(--r);margin-bottom:4px}.location{max-width:720px;margin:30px auto;padding:30px}.location>b{font-size:23px;color:var(--r)}.location a{display:inline-block;margin-top:15px;background:var(--r);color:#fff;padding:12px 22px;border-radius:30px;text-decoration:none;font-weight:bold}.gallery{max-width:900px;margin:30px auto;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gallery img{width:100%;aspect-ratio:1/1.1;object-fit:cover;border:3px solid #fff;border-radius:14px;background:#842335}form{max-width:720px;margin:30px auto;padding:25px;background:linear-gradient(145deg,#a31f30,#5c1019);text-align:left;color:#fff}form input,form select,form textarea{display:block;width:100%;padding:13px;margin:10px 0 15px;border:0;border-radius:9px;outline:0}form textarea{min-height:110px;resize:vertical}form button{width:100%}#status{text-align:center;min-height:20px;font-size:12px;margin-top:8px}#wishes{max-width:720px;margin:15px auto}.wish{background:#fff;padding:15px;border-radius:12px;margin:10px 0;text-align:left}.wish strong{color:var(--r)}.badge{float:right;background:#efe1c2;padding:3px 8px;border-radius:20px;font-size:10px}.orn{color:var(--g);font-size:30px;letter-spacing:8px}.bless{color:var(--r);font-weight:bold;margin-top:20px}footer{background:linear-gradient(rgba(57,9,16,.62),rgba(57,9,16,.72)),
                url('assets/bakcground.png') center/cover fixed no-repeat;color:#fff;text-align:center;padding:55px 20px}footer h3{color:var(--g);font-size:27px;margin:10px}#musicBtn{position:fixed;right:16px;bottom:16px;z-index:10;width:50px;height:50px;border-radius:50%;border:2px solid var(--g);background:var(--r);color:#fff;font-size:20px;cursor:pointer}@media(max-width:700px){section{padding:60px 16px}.couple{grid-template-columns:1fr}.couple>strong{display:none}.events{grid-template-columns:1fr}.gallery{grid-template-columns:repeat(2,1fr)}.count{gap:5px}.count b{font-size:22px}}

/* HADIAH DIGITAL */
.gift-grid{max-width:850px;margin:30px auto;display:grid;grid-template-columns:1fr 1fr;gap:20px}
.gift-card{background:#fff;border:1px solid #ead6a9;border-radius:20px;padding:28px 20px;box-shadow:0 12px 30px #4d1c1010}
.gift-icon{font-size:36px;margin-bottom:8px;color:var(--r)}
.gift-card h3{color:var(--r);font-size:23px;margin-bottom:12px}
.gift-card p{color:var(--mut);line-height:1.7}
.bank-name{font-weight:700!important;color:var(--r)!important;letter-spacing:2px}
.gift-card>strong{display:block;color:var(--r);font-size:25px;letter-spacing:2px;margin:5px 0}
.copy-btn{border:0;border-radius:25px;padding:11px 18px;background:var(--r);color:#fff;font-weight:700;cursor:pointer;margin:12px 0}
.edit-note{display:block;color:#8a766b!important;font-size:11px!important;line-height:1.5!important;margin-top:5px}
.qris-box{width:min(260px,100%);margin:10px auto 14px;padding:10px;background:#fff;border:1px solid #ddd;border-radius:12px}
.qris-box img{display:block;width:100%;aspect-ratio:1;object-fit:contain}
@media(max-width:700px){.gift-grid{grid-template-columns:1fr}}

.creator-box{max-width:390px;margin:34px auto 0;padding:22px 18px 25px;border:1px solid rgba(199,154,73,.6);border-radius:20px;background:rgba(255,255,255,.045)}
.creator-label{color:#ead7ad;font-size:10px;letter-spacing:3px;margin-bottom:12px}
.creator-logo{display:block;width:min(180px,70vw);height:auto;max-height:180px;object-fit:contain;margin:0 auto 15px;border-radius:12px;border:1px solid rgba(199,154,73,.55)}
.creator-text{font-size:13px;color:#eadfce;margin-bottom:12px}
.creator-wa{display:inline-block;color:#fff;text-decoration:none;background:#168b4b;border-radius:30px;padding:11px 18px;line-height:1.45;box-shadow:0 5px 15px #0003}
.creator-wa strong{font-size:16px}
.creator-ig{font-size:11px;color:#d9c9b7;margin-top:13px}
